{
  "version": "1.0",
  "trustPolicies": [
    {
      "name": "control-trust-profile-b",
      "registryScopes": [
        "<ACCOUNT_ID>.dkr.ecr.ap-southeast-1.amazonaws.com/podinfo"
      ],
      "signatureVerification": {
        "level": "strict"
      },
      "trustStores": [
        "signingAuthority:aws-signer-ts"
      ],
      "trustedIdentities": [
        "arn:aws:signer:ap-southeast-1:<ACCOUNT_ID>:/signing-profiles/podinfo_wrong_signer"
      ]
    }
  ]
}
